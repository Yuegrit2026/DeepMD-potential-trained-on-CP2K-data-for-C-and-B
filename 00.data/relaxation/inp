&GLOBAL
    PROJECT_NAME   BC
    RUN_TYPE MD             
    IOLEVEL  MEDIUM   
&END GLOBAL
&FORCE_EVAL
    METHOD Quickstep  
    &DFT   
        BASIS_SET_FILE_NAME  BASIS_MOLOPT  
        POTENTIAL_FILE_NAME  GTH_POTENTIALS
        CHARGE 0
        LSD TRUE                             #a spin-polarized calculation using alpha and beta orbitals
        &QS
            EPS_DEFAULT 1.0E-10
            METHOD GPW             
        &END QS  
        &MGRID
            NGRIDS 5
            CUTOFF 400      #The cutoff of the finest grid level. PW cutoff depends on the element (basis) too small cutoffs lead to the eggbox effect.
            REL_CUTOFF 60   #Determines the grid at which a Gaussian is mapped, giving the cutoff used for a gaussian with alpha=1 
        &END MGRID
        &XC
            &XC_FUNCTIONAL PBE
            &END XC_FUNCTIONAL
        &END XC    
        &SCF
            SCF_GUESS  ATOMIC   #must be RESTART in order to read well converged WFN from external file
            EPS_SCF 1.0E-7      #accuracy of the SCF procedure typically 1.0E-6 - 1.0E-7
            MAX_SCF 300
            ADDED_MOS 30        #Number of virtual MOs to be solved when using FERMI_DIRAC method. 
	    #对角化计算
            &SMEAR ON                      #smear allows for fractional orbital occupations. The expectation value of S**2 is only defined for calculation with inter orbital occupations, not calculated/printed when SMEAR is active.
              METHOD FERMI_DIRAC
              ELECTRONIC_TEMPERATURE [K] 300
            &END SMEAR
            &DIAGONALIZATION
              ALGORITHM STANDARD           #一般为STANDARD。DAVIDSON is faster for large systems
            &END DIAGONALIZATION
            &MIXING
              METHOD BROYDEN_MIXING
              ALPHA 0.4                    #Default. Mixing 40% of new density matrix with the old one
              BETA 0.5
              NBROYDEN 8                   #Default is 4. Number of previous steps stored for the actual mixing scheme
            &END MIXING
            &OUTER_SCF T                   #对角化算法时也可以用
              EPS_SCF 1.0E-7
              MAX_SCF 5
            &END OUTER_SCF
        &END SCF
        &POISSON                           #for non-periodic system，need Solver。gas phase systems should have 'NONE' and a wavelet solver
          POISSON_SOLVER  PERIODIC
          PERIODIC XYZ    
        &END POISSON
    &END DFT   
    &SUBSYS
        &KIND C                       
            ELEMENT   C
            BASIS_SET DZVP-MOLOPT-SR-GTH-q4
            POTENTIAL GTH-PBE-q4
            MAGNETIZATION 0
        &END KIND
        &KIND B                      
            ELEMENT   B
            BASIS_SET DZVP-MOLOPT-SR-GTH-q3
            POTENTIAL GTH-PBE-q3
            MAGNETIZATION 0
        &END KIND
        &CELL
          ABC 3.567 3.567 3.567
          ALPHA_BETA_GAMMA 90.0 90.0 90.0
		  MULTIPLE_UNIT_CELL 3 3 3   ! 1. 放大盒子的物理空间
        &END CELL
		&TOPOLOGY
          MULTIPLE_UNIT_CELL 3 3 3   ! 2. 复制原子以填充新盒子
        &END TOPOLOGY
        &COORD
          SCALED .TRUE.          ! 关键：使用分数坐标
          C  0.000000  0.000000  0.000000
          B  0.000000  0.500000  0.500000
          C  0.500000  0.000000  0.500000
          B  0.500000  0.500000  0.000000
          C  0.250000  0.250000  0.250000
          B  0.250000  0.750000  0.750000
          C  0.750000  0.250000  0.750000
          B  0.750000  0.750000  0.250000
        &END COORD
    &END SUBSYS
&END FORCE_EVAL

&MOTION
