    &MD
    ENSEMBLE NVT              ! 指定系综为NVT
    STEPS 10000               ! 模拟步数
    TIMESTEP 0.5              ! 时间步长，单位fs，AIMD推荐0.5fs，经典力场可用1-2fs 
    TEMPERATURE 5000.0         ! 目标温度，单位K
    &THERMOSTAT
      TYPE CSVR               ! 选择恒温器类型，例如CSVR
      &CSVR
        TIMECON 100.0         ! 时间常数，与热浴耦合强度相关，单位fs
      &END CSVR
    &END THERMOSTAT
    &END MD
    &PRINT
        &TRAJECTORY
          FORMAT XYZ
          &EACH
            MD 1
          &END EACH
        &END TRAJECTORY
        &FORCES
          FORMAT XYZ
          &EACH
            MD 1
          &END EACH
        &END FORCES
        &RESTART_HISTORY
            &EACH
              MD 500
            &END EACH
        &END RESTART_HISTORY
        &RESTART                 #输出restart文件，默认保留三个文件
            BACKUP_COPIES 1     #指定副本的最大数量
            #FILENAME =restart
            &EACH
              MD 1
            &END EACH
        &END RESTART
    &END PRINT
&END MOTION
